{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vimuktam-website",
  "main": "./worker.js",
  "compatibility_date": "2026-08-15",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GITHUB_REPO": "pegasusmilan/Vimuktam-Website"
  },
  "r2_buckets": [
    {
      "binding": "MULTIMEDIA",
      "bucket_name": "vimuktam-multimedia"
    }
  ]
}
